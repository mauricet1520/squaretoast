# Copy to /opt/squaretoast/.env on the server, then: chmod 600 .env. Never commit the real file.
# The server's name for HTTPS. With no domain, use the IP with dashes + .sslip.io, e.g. 203-0-113-7.sslip.io
PUBLIC_HOST=
# A long random password; setup-server.sh fills this in.
POSTGRES_PASSWORD=
# Stripe TEST keys only for now (sk_test_..., whsec_...). You type these yourself; deploy.sh refuses live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRETS=
