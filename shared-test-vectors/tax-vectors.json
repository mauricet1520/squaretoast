      "rules": [{"state": "CA", "jurisdiction": "CA-SF", "category": "FOOD", "channel": null, "ratePpm": 86250, "from": "2026-01-01", "to": null}],
      "lines": [{"category": "FOOD", "temp": "HOT", "cents": 1000}, {"category": "FOOD", "temp": "HOT", "cents": 1000}],
      "charges": [],
      "expected": {"taxable": 2000, "exempt": 0, "tax": 173}
