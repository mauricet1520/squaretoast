{
  "description": "Sales tax for one check (plan §4, S14-2). Rate per category = sum over jurisdictions; a channel rule replaces that jurisdiction's any-channel rule; CA cold food to go is exempt unless 80/80 applies without separate accounting; tax is rounded half-up once per check. Rates are ppm, amounts are cents. 'expected': null means no effective rule (fail closed). Tips are always 0 here: they are never taxed.",
  "cases": [
    {
      "name": "CA hot food dine-in",
      "context": {"state": "CA", "date": "2026-11-17", "channel": "DINE_IN", "ca8080": false, "caSeparate": false, "mandatoryTaxable": true},
      "rules": [{"state": "CA", "jurisdiction": "CA-SF", "category": "FOOD", "channel": null, "ratePpm": 86250, "from": "2026-01-01", "to": null}],
      "lines": [{"category": "FOOD", "temp": "HOT", "cents": 1000}],
      "charges": [],
      "expected": {"taxable": 1000, "exempt": 0, "tax": 86}
    },
    {
      "name": "CA cold food to go is exempt",
      "context": {"state": "CA", "date": "2026-11-17", "channel": "TAKEOUT", "ca8080": false, "caSeparate": false, "mandatoryTaxable": true},
      "rules": [{"state": "CA", "jurisdiction": "CA-SF", "category": "FOOD", "channel": null, "ratePpm": 86250, "from": "2026-01-01", "to": null}],
      "lines": [{"category": "FOOD", "temp": "COLD", "cents": 1000}],
      "charges": [],
      "expected": {"taxable": 0, "exempt": 1000, "tax": 0}
    },
    {
      "name": "CA cold food to go is taxed under 80/80",
      "context": {"state": "CA", "date": "2026-11-17", "channel": "DELIVERY", "ca8080": true, "caSeparate": false, "mandatoryTaxable": true},
      "rules": [{"state": "CA", "jurisdiction": "CA-SF", "category": "FOOD", "channel": null, "ratePpm": 86250, "from": "2026-01-01", "to": null}],
      "lines": [{"category": "FOOD", "temp": "COLD", "cents": 1000}],
      "charges": [],
      "expected": {"taxable": 1000, "exempt": 0, "tax": 86}
    },
    {
      "name": "CA 80/80 with separate accounting stays exempt",
      "context": {"state": "CA", "date": "2026-11-17", "channel": "TAKEOUT", "ca8080": true, "caSeparate": true, "mandatoryTaxable": true},
      "rules": [{"state": "CA", "jurisdiction": "CA-SF", "category": "FOOD", "channel": null, "ratePpm": 86250, "from": "2026-01-01", "to": null}],
      "lines": [{"category": "FOOD", "temp": "COLD", "cents": 1000}],
      "charges": [],
      "expected": {"taxable": 0, "exempt": 1000, "tax": 0}
